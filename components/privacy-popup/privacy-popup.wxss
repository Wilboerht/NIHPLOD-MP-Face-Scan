.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: #3D4430;
}

.content {
  font-size: 28rpx;
  color: #5a5546;
  margin-bottom: 40rpx;
}

.link {
  color: #6b7a4f;
}

.actions {
  display: flex;
  gap: 24rpx;
}

.btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 999rpx;
}

.btn-decline {
  background: #efeae0;
  color: #3D4430;
}

.btn-agree {
  background: #3D4430;
  color: #F2EDE5;
}
