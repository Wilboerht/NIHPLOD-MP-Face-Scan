/* 全局样式：品牌米色 #F2EDE5 背景、深棕 #3D4430 主文字 */
page {
  background-color: #F2EDE5;
  color: #3D4430;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 68, 48, 0.06);
}

.btn-primary {
  background: #3D4430;
  color: #F2EDE5;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  text-align: center;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-plain {
  background: transparent;
  color: #3D4430;
  border: 2rpx solid #3D4430;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}

.text-muted {
  color: #8a8577;
  font-size: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 32rpx 0 16rpx;
}
