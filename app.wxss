/* 全局样式：与 nihplod-points-mp 保持同一套暖米色/棕色 token。
   logo 深蓝 #00263e 保留，不用于按钮主色。 */
page {
  --color-bg: #f7f5f2;
  --color-card: #ffffff;
  --color-text: #2b2b2b;
  --color-text-secondary: #5f5a54;
  --color-muted: #767676;
  --color-muted-strong: #6f6f6f;
  --color-primary: #8a6d4b;
  --color-primary-strong: #7d5f3e;
  --color-primary-soft: rgba(138, 109, 75, 0.06);
  --color-primary-soft-2: rgba(138, 109, 75, 0.1);
  --color-danger: #c25450;
  --color-danger-strong: #b84b47;
  --color-danger-soft: rgba(194, 84, 80, 0.08);
  --color-success: #3f8f5f;
  --color-success-strong: #357d51;
  --color-success-soft: rgba(63, 143, 95, 0.1);
  --color-border: rgba(43, 43, 43, 0.08);
  --color-warm: #f3ece4;
  --color-warm-soft: #f7f1e7;
  --color-placeholder: #efeae4;
  --color-logo-navy: #00263e;
  --radius-card: 20rpx;
  --radius-btn: 44rpx;
  --tap-min: 88rpx;
  --shadow-card: 0 2rpx 12rpx rgba(43, 43, 43, 0.03);
  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.btn-primary,
.btn-plain,
.btn-danger {
  display: block;
  width: auto;
  height: var(--tap-min);
  line-height: var(--tap-min);
  padding: 0 32rpx;
  margin: 0;
  border-radius: var(--radius-btn);
  border: none;
  box-sizing: border-box;
  font-size: 30rpx;
  text-align: center;
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
}

.btn-plain {
  background: var(--color-primary-soft-2);
  color: var(--color-primary-strong);
}

.btn-danger {
  background: var(--color-danger-strong);
  color: #ffffff;
}

.btn-primary.button-hover {
  background: var(--color-primary-strong);
}

.btn-plain.button-hover {
  background: rgba(138, 109, 75, 0.16);
}

.btn-danger.button-hover {
  background: var(--color-danger);
}

.btn-primary[disabled],
.btn-plain[disabled],
.btn-danger[disabled] {
  opacity: 0.5;
}

/* 去掉微信按钮默认描边，避免主色按钮上残留细线 */
button::after {
  border: none;
}

.text-muted {
  color: var(--color-muted-strong);
  font-size: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin: 32rpx 0 16rpx;
}

/* 通用点击反馈与文字链热区 */
.tap-hover {
  opacity: 0.86;
}

.row-hover {
  background: rgba(43, 43, 43, 0.03);
}

.chip-hover {
  opacity: 0.72;
}

.tap-hot {
  padding: 16rpx 8rpx;
  margin: -16rpx -8rpx;
}

.safe-bottom {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading-block {
  text-align: center;
  color: var(--color-muted-strong);
  font-size: 26rpx;
  padding: 120rpx 0;
}

.input-placeholder {
  color: var(--color-muted);
}

/* 自绘导航栏：与积分小程序一致，固定悬浮，logo 使用深蓝原图 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  box-sizing: content-box;
  background: var(--color-bg);
}

.nav-logo {
  width: 200rpx;
  height: 56rpx;
}
