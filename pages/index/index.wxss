/* 自绘导航栏：状态栏占位由内联 padding-top 提供，内容区与系统导航栏同高 44px */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  box-sizing: content-box;
}

.nav-logo {
  width: 200rpx;
  height: 56rpx;
}

.hero {
  text-align: center;
  padding: 120rpx 0 80rpx;
}

.brand {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.slogan {
  font-size: 32rpx;
  margin-top: 24rpx;
  color: #5a5546;
}

.desc {
  font-size: 24rpx;
  margin-top: 16rpx;
  color: #8a8577;
}

.start-btn {
  margin: 0 32rpx;
}

.privacy-line {
  margin: 20rpx 32rpx 0;
  text-align: center;
  line-height: 1.7;
}

.privacy-link {
  color: #6b7a4f;
}

.privacy-warn {
  margin: 20rpx 32rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #FBF3E4;
  color: #8a6d4b;
  font-size: 24rpx;
  text-align: center;
}

.privacy-agree {
  margin-left: 12rpx;
  color: #5c4937;
  text-decoration: underline;
}

.history-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 40rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.arrow {
  color: #b5ad9c;
  font-size: 36rpx;
}

.hello {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 40rpx;
}

.edit-link {
  font-size: 24rpx;
  color: #6b7a4f;
  border: 2rpx solid #6b7a4f;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}

.logout-entry {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  padding: 16rpx;
}
