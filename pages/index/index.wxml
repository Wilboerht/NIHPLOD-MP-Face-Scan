<!-- 自绘导航栏（index.json navigationStyle: custom）：固定悬浮，logo 保持深蓝原色 -->
<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <image class="nav-logo" src="/images/nihplod-logo.svg" mode="aspectFit" aria-label="肌智派" />
</view>
<view style="height: {{statusBarHeight + 44}}px;"></view>

<view class="container">
  <view class="hero">
    <view class="brand">肌智派</view>
    <view class="slogan">AI 智能测肤 · 一张照片读懂你的肌肤</view>
    <view class="desc">十维肌肤评分 · 分区问题定位 · 个性化护肤方案</view>
  </view>

  <button class="btn-primary start-btn" bindtap="onStart">开始测肤</button>

  <view wx:if="{{!privacyChecking && !privacyReady}}" class="privacy-warn">
    <text>需同意隐私政策后才能开始测肤</text>
    <text class="privacy-agree" bindtap="onAgreePrivacy">去同意</text>
  </view>

  <view class="privacy-line text-muted">
    开始测肤即表示同意
    <text class="privacy-link" bindtap="onOpenTerms">《用户协议》</text>
    与
    <text class="privacy-link" bindtap="onOpenPrivacy">《隐私政策》</text>
  </view>

  <view class="prep-card card">
    <view class="prep-title">开始前准备</view>
    <view class="prep-row">素颜或淡妆，摘掉眼镜、口罩和帽子</view>
    <view class="prep-row">正对自然光，避免逆光和强烈滤镜</view>
    <view class="prep-row">全程约 2 分钟，完成后可在历史报告查看</view>
  </view>

  <view class="history-entry" bindtap="onGoArchive" hover-class="row-hover" aria-role="button" aria-label="我的测肤档案">
    <text>我的测肤档案</text>
    <text class="arrow" aria-hidden="true">›</text>
  </view>

  <view class="history-entry" bindtap="onGoHistory" hover-class="row-hover" aria-role="button" aria-label="查看历史报告">
    <text>查看历史报告</text>
    <text class="arrow" aria-hidden="true">›</text>
  </view>

  <view class="history-entry" bindtap="onGoPointsMall" hover-class="row-hover" aria-role="button" aria-label="打开积分商城">
    <text>积分商城</text>
    <text class="arrow" aria-hidden="true">›</text>
  </view>

  <view class="hello" wx:if="{{isLoggedIn && user}}">
    <text class="text-muted">你好，{{user.name || '护肤达人'}}</text>
    <text class="edit-link" bindtap="onEditProfile" hover-class="chip-hover" aria-role="button">用户中心</text>
  </view>
</view>
