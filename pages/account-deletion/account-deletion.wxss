.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.tip {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.action-btn {
  margin-top: 24rpx;
}

.reason-input {
  width: 100%;
  height: auto;
  min-height: 120rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--color-warm-soft);
  font-size: 28rpx;
  color: var(--color-text);
}

.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.code-input {
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  height: 88rpx;
}

.code-btn {
  flex-shrink: 0;
  width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
}

.confirm-label {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.confirm-text {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.contact-btn {
  margin-top: 20rpx;
}

.error-card {
  color: var(--color-danger-strong);
  font-size: 26rpx;
}

.retry-btn {
  margin-top: 20rpx;
}

.link {
  display: inline;
  min-height: 0;
  padding: 16rpx 8rpx;
  margin: -16rpx -8rpx;
  color: var(--color-primary);
  text-decoration: underline;
}

.state {
  padding: 80rpx 0;
  text-align: center;
}

.login-btn {
  margin-top: 24rpx;
}

.warn-card {
  background: var(--color-danger-soft);
  border: 1rpx solid rgba(194, 84, 80, 0.16);
}

.warn-card .card-title {
  color: var(--color-danger-strong);
}
