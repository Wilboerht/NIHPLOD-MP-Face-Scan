.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.tip {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.action-btn {
  margin-top: 24rpx;
}

.reason-input {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--color-warm-soft);
  font-size: 28rpx;
  color: var(--color-text);
}

.confirm-label {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.confirm-text {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.contact-btn {
  margin-top: 20rpx;
}

.error-card {
  color: var(--color-danger-strong);
  font-size: 26rpx;
}

.retry-btn {
  margin-top: 20rpx;
}

.link {
  padding: 16rpx 8rpx;
  margin: -16rpx -8rpx;
  color: var(--color-primary);
  text-decoration: underline;
}

.state {
  padding: 80rpx 0;
  text-align: center;
}

.login-btn {
  margin-top: 24rpx;
}

.warn-card {
  background: var(--color-danger-soft);
  border: 1rpx solid rgba(194, 84, 80, 0.16);
}

.warn-card .card-title {
  color: var(--color-danger-strong);
}
