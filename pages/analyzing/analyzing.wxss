.analyzing-page {
  padding-top: 200rpx;
  text-align: center;
}

.spinner {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 48rpx;
  border: 8rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.stage {
  font-size: 32rpx;
  margin-bottom: 32rpx;
}

.progress-bar {
  width: 560rpx;
  height: 12rpx;
  margin: 0 auto;
  background: var(--color-border);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: var(--color-primary);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.tip {
  margin-top: 40rpx;
}

.error-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 40rpx;
  border-radius: 50%;
  background: var(--color-danger);
  color: #ffffff;
  font-size: 56rpx;
  line-height: 96rpx;
}

.error-text {
  font-size: 30rpx;
  margin-bottom: 48rpx;
  padding: 0 48rpx;
}

.retry-btn {
  margin: 0 64rpx 24rpx;
}

.back-btn {
  margin: 0 64rpx;
}
