/* 用户中心 */
.user-head {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 40rpx 32rpx;
  background: var(--color-warm);
  box-shadow: none;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-border);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #ffffff;
  background: var(--color-primary);
}

.head-info {
  min-width: 0;
  flex: 1;
}

.head-name {
  font-size: 36rpx;
  font-weight: 600;
}

.head-tip {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
}

/* 信息行 */
.row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
}

.row-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-muted-strong);
}

.row-value {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.row-actions {
  display: flex;
  gap: 28rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.row-modify {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

.row-lock {
  font-size: 24rpx;
  color: var(--color-muted-strong);
  margin-left: 24rpx;
  flex-shrink: 0;
}

.row.nav .arrow {
  margin-left: 16rpx;
  color: #b8a992;
  font-size: 36rpx;
}

.divider {
  height: 2rpx;
  background: var(--color-border);
}

.link-plain {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-muted-strong);
}

.link-strong {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 600;
}

/* 行内展开面板 */
.inline-panel {
  padding: 8rpx 0 24rpx 160rpx;
}

.inline-tip {
  margin-bottom: 20rpx;
}

.opt-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.opt {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.opt-active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.picker-field {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0;
  font-size: 30rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.picker-placeholder {
  color: var(--color-muted);
}

/* 会员与用量 */
.vip-level {
  font-size: 32rpx;
  font-weight: 600;
}

.vip-usage {
  margin-top: 12rpx;
}

.hint {
  margin-top: 12rpx;
}

.logout-btn {
  margin: 48rpx 0 24rpx;
}

.menu-contact {
  position: relative;
}

.contact-hit {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: auto;
  height: auto;
  margin: 0;
  padding: 0;
  background: transparent;
  opacity: 0;
  z-index: 1;
}

.contact-hit::after {
  border: none;
}

.danger-card {
  border: 1rpx solid var(--color-danger-soft);
  background: var(--color-card);
}

.row.nav.danger-row .row-label,
.row.nav.danger-row .row-value,
.row.nav.danger-row .arrow {
  color: var(--color-danger-strong);
}
