.state {
  text-align: center;
  padding: 100rpx 0;
}

.retry {
  margin: 40rpx auto 0;
  width: 300rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tip {
  line-height: 1.7;
}

.field-label {
  font-size: 26rpx;
  color: var(--color-muted-strong);
  margin: 28rpx 0 12rpx;
}

.req {
  color: var(--color-danger-strong);
}

.field-input {
  display: flex;
  align-items: center;
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  padding: 0;
  border-bottom: 2rpx solid var(--color-border);
  box-sizing: border-box;
}

.picker-field {
  height: 88rpx;
}

.picker-placeholder {
  color: var(--color-muted);
}

.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.default-label {
  font-size: 28rpx;
}

.submit-btn {
  margin-top: 48rpx;
}

.cancel-btn {
  margin-top: 24rpx;
}

.add-btn {
  margin-top: 32rpx;
}

.limit-tip {
  text-align: center;
  margin-top: 32rpx;
}

/* 地址卡片 */
.addr {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 100rpx;
}

.addr-main {
  min-width: 0;
  flex: 1;
}

.addr-line1 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
}

.addr-badge {
  font-size: 22rpx;
  color: var(--color-primary-strong);
  background: var(--color-primary-soft-2);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}

.addr-detail {
  margin-top: 12rpx;
  line-height: 1.6;
}

.addr-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
}

.link {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

.link-danger {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-danger-strong);
}

.link-plain {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-muted-strong);
}
