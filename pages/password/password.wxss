.state {
  text-align: center;
  padding: 120rpx 0;
}

.mode-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tip {
  line-height: 1.7;
}

.field-label {
  font-size: 26rpx;
  color: var(--color-muted-strong);
  margin: 28rpx 0 12rpx;
}

.field-input {
  display: flex;
  align-items: center;
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  padding: 0;
  border-bottom: 2rpx solid var(--color-border);
  box-sizing: border-box;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 24rpx;
  font-size: 26rpx;
  line-height: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft-2);
  color: var(--color-primary-strong);
}

.code-btn[disabled] {
  opacity: 0.5;
}

.strength-tip {
  margin-top: 24rpx;
}

.submit-btn {
  margin-top: 48rpx;
}

.relogin-tip {
  text-align: center;
  margin-top: 24rpx;
}

.pw-toggle {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}
