<view class="container safe-bottom">
  <view wx:if="{{loading}}" class="state text-muted">加载中…</view>

  <block wx:else>
    <view class="card">
      <view class="mode-title">{{mode === 'change' ? '修改密码' : '设置密码（短信验证）'}}</view>
      <view class="tip text-muted" wx:if="{{mode === 'set'}}">您的账号尚未设置密码，请通过手机验证码设置。</view>

      <block wx:if="{{mode === 'change'}}">
        <view class="field-label">旧密码</view>
        <input class="field-input" password="{{!showPassword}}" maxlength="32" cursor-spacing="24" placeholder-class="input-placeholder" value="{{oldPassword}}" placeholder="输入当前密码" bindinput="onOldInput" />
      </block>

      <block wx:if="{{mode === 'set'}}">
        <view class="field-label">短信验证码</view>
        <view class="code-row">
          <input
            class="field-input code-input"
            type="number"
            value="{{code}}"
            maxlength="6"
            cursor-spacing="24"
            placeholder-class="input-placeholder"
            placeholder="6位验证码"
            bindinput="onCodeInput"
          />
          <button
            class="code-btn"
            size="mini"
            disabled="{{countdown > 0 || sending}}"
            bindtap="onSendCode"
          >{{countdown > 0 ? countdown + 's 后重发' : '发送验证码'}}</button>
        </view>
      </block>

      <view class="field-label">{{mode === 'change' ? '新密码' : '密码'}}</view>
      <input class="field-input" password="{{!showPassword}}" maxlength="32" cursor-spacing="24" placeholder-class="input-placeholder" value="{{newPassword}}" placeholder="8-32位，含大小写字母和数字" bindinput="onNewInput" />

      <view class="field-label">{{mode === 'change' ? '确认新密码' : '确认密码'}}</view>
      <input class="field-input" password="{{!showPassword}}" maxlength="32" cursor-spacing="24" placeholder-class="input-placeholder" value="{{confirmPassword}}" placeholder="再次输入密码" bindinput="onConfirmInput" />

      <view class="tip text-muted strength-tip">密码要求：8-32 位，需包含大写字母、小写字母和数字。</view>
      <view class="pw-toggle" bindtap="onTogglePassword" hover-class="chip-hover" aria-role="button">{{showPassword ? '隐藏密码' : '显示密码'}}</view>
    </view>

    <button
      class="btn-primary submit-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >{{mode === 'change' ? '修改密码' : '设置密码'}}</button>

    <view class="tip text-muted relogin-tip">为保障账户安全，密码更新后需重新登录。</view>
  </block>
</view>
