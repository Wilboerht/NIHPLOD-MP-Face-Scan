<view class="container result-page">
  <view wx:if="{{loading}}" class="state text-muted">报告加载中…</view>

  <view wx:elif="{{loadError}}" class="state">
    <view class="text-muted">{{loadError}}</view>
    <button class="btn-plain retry" bindtap="onBackHome">返回首页</button>
  </view>

  <block wx:else>
    <!-- 总览卡 -->
    <view class="card overview">
      <view class="nickname" wx:if="{{nickname}}">{{nickname}} 的肌肤报告</view>
      <view class="score-row">
        <view class="score" wx:if="{{overallScore !== null}}">
          <text class="score-num">{{overallScore}}</text>
          <text class="score-unit">分</text>
        </view>
        <view class="meta">
          <view wx:if="{{skinTypeLabel}}">肤质：{{skinTypeLabel}}</view>
          <view wx:if="{{skinAge !== null}}">肌龄：{{skinAge}} 岁</view>
          <view class="text-muted" wx:if="{{analyzedAt}}">{{analyzedAt}}</view>
        </view>
      </view>
      <view class="summary" wx:if="{{summary}}">{{summary}}</view>
    </view>

    <!-- 十维评分：雷达图 + 数据明细列表 -->
    <view class="section-title" wx:if="{{dimensionList.length}}">十维肌肤评分</view>
    <view class="card radar-card" wx:if="{{hasRadar}}">
      <canvas type="2d" id="radarCanvas" class="radar-canvas"></canvas>
    </view>
    <view class="card" wx:if="{{dimensionList.length}}">
      <view class="dim-row" wx:for="{{dimensionList}}" wx:key="key">
        <view class="dim-label">{{item.label}}</view>
        <view class="dim-bar">
          <view class="dim-bar-inner" style="width: {{item.score || 0}}%"></view>
        </view>
        <view class="dim-score">{{item.score}}<text class="dim-grade" wx:if="{{item.gradeLabel}}"> {{item.gradeLabel}}</text></view>
      </view>
    </view>

    <!-- 重点问题（v2 顾问报告） -->
    <view class="section-title" wx:if="{{issues.length}}">重点问题</view>
    <view class="card issue" wx:for="{{issues}}" wx:key="title" wx:for-item="issue">
      <view class="issue-head">
        <view class="issue-title">{{issue.title}}</view>
        <view class="issue-sev" wx:if="{{issue.severityLabel}}">{{issue.severityLabel}}</view>
      </view>
      <view class="issue-block" wx:if="{{issue.observation}}">观察：{{issue.observation}}</view>
      <view class="issue-block" wx:if="{{issue.directCauses}}">诱因：{{issue.directCauses}}</view>
      <view class="issue-block" wx:if="{{issue.skincarePlan}}">护理方案：{{issue.skincarePlan}}</view>
      <view class="issue-block" wx:if="{{issue.lifestylePlan}}">生活建议：{{issue.lifestylePlan}}</view>
      <view class="issue-block text-muted" wx:if="{{issue.medicalBoundary}}">就医边界：{{issue.medicalBoundary}}</view>
    </view>

    <!-- 检测到的肌肤状况 -->
    <view class="section-title" wx:if="{{conditions.length}}">肌肤状况</view>
    <view class="card" wx:if="{{conditions.length}}">
      <view class="cond-row" wx:for="{{conditions}}" wx:key="condition">
        <text class="cond-name">{{item.condition}}</text>
        <text class="cond-sev" wx:if="{{item.severityLabel}}">{{item.severityLabel}}</text>
        <text class="cond-area text-muted" wx:if="{{item.area}}">{{item.area}}</text>
      </view>
    </view>

    <!-- 分区分析 -->
    <view class="section-title" wx:if="{{zoneList.length}}">分区分析</view>
    <view class="card" wx:if="{{zoneList.length}}">
      <view class="zone" wx:for="{{zoneList}}" wx:key="key">
        <view class="zone-label">{{item.label}}</view>
        <view class="zone-body">
          <view wx:if="{{item.condition}}">{{item.condition}}</view>
          <view class="text-muted" wx:if="{{item.advice}}">建议：{{item.advice}}</view>
        </view>
      </view>
    </view>

    <!-- 肌肤优势 -->
    <view class="section-title" wx:if="{{strengths.length}}">肌肤优势</view>
    <view class="card" wx:if="{{strengths.length}}">
      <view class="strength" wx:for="{{strengths}}" wx:key="*this">· {{item}}</view>
    </view>

    <!-- 推荐产品 -->
    <view class="section-title" wx:if="{{products.length}}">为你推荐</view>
    <view class="card product" wx:for="{{products}}" wx:key="id" wx:for-item="p" wx:for-index="pi">
      <view class="p-main" data-index="{{pi}}" bindtap="onOpenProduct" hover-class="row-hover" aria-role="button" aria-label="查看{{p.name}}详情">
        <image wx:if="{{p.displayImage}}" class="p-thumb" src="{{p.displayImage}}" mode="aspectFill" lazy-load />
        <view class="p-body">
          <view class="p-name">{{p.name}}</view>
          <view class="p-benefits" wx:if="{{p.benefitsText}}">{{p.benefitsText}}</view>
          <view class="p-reason text-muted" wx:if="{{p.reason}}">{{p.reason}}</view>
          <view class="p-proof" wx:if="{{p.socialProofText}}">★ {{p.socialProofText}}</view>
          <view class="p-meta" wx:if="{{p.origin || p.capacity}}">
            <text wx:if="{{p.origin}}">产地：{{p.origin}}</text>
            <text wx:if="{{p.capacity}}">规格：{{p.capacity}}</text>
          </view>
          <view class="p-price-row">
            <view class="p-price" wx:if="{{p.priceText}}">{{p.priceText}}</view>
            <view class="p-detail-hint">查看详情 ›</view>
          </view>
        </view>
      </view>
      <view class="p-actions" wx:if="{{p.buyOptions.length > 0}}">
        <button
          wx:for="{{p.buyOptions}}"
          wx:key="platformKey"
          class="p-btn {{item.primary ? 'p-btn-primary' : ''}}"
          data-kind="{{item.kind}}"
          data-url="{{item.url}}"
          data-short-link="{{item.shortLink}}"
          data-platform="{{item.platform}}"
          catchtap="onBuyOption"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="ai-disclaimer">
      结果由 AI 分析生成，仅供护肤参考，不构成医疗诊断。推荐商品可能包含推广链接，请按需选择。
    </view>

    <view class="home text-muted" bindtap="onBackHome" hover-class="chip-hover" aria-role="button">返回首页</view>

    <view class="report-actions-bar">
      <button class="btn-plain report-action" bindtap="onSavePoster">保存证书</button>
      <button class="btn-primary report-action" open-type="share">分享给朋友</button>
    </view>

    <!-- 海报离屏画布（1440×1920 缓冲，移出可视区） -->
    <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>
  </block>

  <!-- 产品详情弹层（对齐 H5 ProductDetailModal：图库/名称/价格/推荐理由/成分/功效/用法/购买） -->
  <view class="sheet-mask" wx:if="{{detailOpen && detailProduct}}" bindtap="onCloseDetail" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="pd-close" bindtap="onCloseDetail" hover-class="chip-hover" aria-role="button" aria-label="关闭产品详情">✕</view>

      <swiper
        wx:if="{{detailProduct.galleryImages.length > 0}}"
        class="pd-swiper"
        indicator-dots="{{detailProduct.galleryImages.length > 1}}"
        indicator-color="rgba(0,0,0,0.15)"
        indicator-active-color="#8a6d4b"
        circular
      >
        <swiper-item wx:for="{{detailProduct.galleryImages}}" wx:key="*this">
          <image class="pd-image" src="{{item}}" mode="aspectFit" lazy-load />
        </swiper-item>
      </swiper>

      <scroll-view scroll-y class="pd-scroll">
        <view class="pd-body">
          <view class="pd-cat" wx:if="{{detailProduct.category}}">{{detailProduct.category}}</view>
          <view class="pd-name">{{detailProduct.name}}</view>
          <view class="pd-price" wx:if="{{detailProduct.priceText}}">{{detailProduct.priceText}}</view>
          <view class="pd-meta" wx:if="{{detailProduct.origin || detailProduct.capacity}}">
            <text wx:if="{{detailProduct.origin}}">产地：{{detailProduct.origin}}</text>
            <text wx:if="{{detailProduct.capacity}}">规格：{{detailProduct.capacity}}</text>
          </view>
          <view class="pd-reason" wx:if="{{detailProduct.reason}}">{{detailProduct.reason}}</view>

          <view class="pd-section" wx:if="{{detailProduct.descriptionText}}">
            <view class="pd-sec-title">产品介绍</view>
            <view class="pd-text pd-pre">{{detailProduct.descriptionText}}</view>
          </view>

          <view class="pd-section" wx:if="{{detailProduct.keyIngredients.length > 0}}">
            <view class="pd-sec-title">核心成分</view>
            <view class="pd-ing" wx:for="{{detailProduct.keyIngredients}}" wx:key="*this">· {{item}}</view>
          </view>

          <view class="pd-section" wx:if="{{detailProduct.benefitsText}}">
            <view class="pd-sec-title">主要功效</view>
            <view class="pd-text">{{detailProduct.benefitsText}}</view>
          </view>

          <view class="pd-section" wx:if="{{detailProduct.howToUse}}">
            <view class="pd-sec-title">使用方法</view>
            <view class="pd-text">{{detailProduct.howToUse}}</view>
          </view>

          <view class="pd-search" wx:if="{{detailProduct.searchKeyword}}" bindtap="onCopySearchKeyword" hover-class="chip-hover" aria-role="button">
            去小红书了解更多（复制搜索词） ›
          </view>

          <view class="pd-actions" wx:if="{{detailProduct.buyOptions.length > 0}}">
            <button
              wx:for="{{detailProduct.buyOptions}}"
              wx:key="platformKey"
              class="p-btn {{item.primary ? 'p-btn-primary' : ''}}"
              data-kind="{{item.kind}}"
              data-url="{{item.url}}"
              data-short-link="{{item.shortLink}}"
              data-platform="{{item.platform}}"
              catchtap="onBuyOption"
            >{{item.label}}</button>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
