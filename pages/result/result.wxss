.state {
  text-align: center;
  padding: 120rpx 0;
}

.retry {
  margin: 40rpx auto 0;
  width: 300rpx;
}

.overview {
  background: var(--color-warm);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(43, 43, 43, 0.08);
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.score-num {
  font-size: 96rpx;
  font-weight: 700;
  color: var(--color-logo-navy);
}

.score-unit {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-left: 8rpx;
}

.meta {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.summary {
  margin-top: 24rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.dim-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dim-label {
  width: 180rpx;
  font-size: 26rpx;
}

.dim-bar {
  flex: 1;
  height: 10rpx;
  background: var(--color-border);
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.dim-bar-inner {
  height: 100%;
  background: var(--color-primary);
  border-radius: 999rpx;
}

.dim-score {
  width: 140rpx;
  font-size: 26rpx;
  text-align: right;
}

.dim-grade {
  color: var(--color-muted-strong);
  font-size: 22rpx;
}

.issue-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.issue-title {
  font-size: 30rpx;
  font-weight: 600;
}

.issue-sev {
  font-size: 22rpx;
  color: var(--color-danger-strong);
  border: 2rpx solid var(--color-danger-strong);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}

.issue-block {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 10rpx;
}

.cond-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.cond-name {
  font-size: 28rpx;
}

.cond-sev {
  font-size: 22rpx;
  color: var(--color-danger-strong);
}

.zone {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.zone-label {
  width: 120rpx;
  font-weight: 600;
  font-size: 26rpx;
}

.zone-body {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.strength {
  padding: 8rpx 0;
  color: var(--color-text-secondary);
}

.p-main {
  display: flex;
  gap: 24rpx;
}

.p-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--color-placeholder);
  flex-shrink: 0;
}

.p-body {
  flex: 1;
  min-width: 0;
}

.p-name {
  font-weight: 600;
}

.p-benefits {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-primary-strong);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p-reason {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.p-proof {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-primary-strong);
  background: var(--color-primary-soft);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.p-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.p-price {
  color: var(--color-primary);
  font-weight: 600;
}

.p-detail-hint {
  font-size: 24rpx;
  color: var(--color-primary);
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action {
  flex: 1;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.radar-card {
  display: flex;
  justify-content: center;
}

.radar-canvas {
  width: 620rpx;
  height: 620rpx;
  margin: 0 auto;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 360px;
  height: 480px;
}

.p-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.p-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.p-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft-2);
  color: var(--color-primary-strong);
  margin: 0;
  font-size: 26rpx;
  line-height: 1;
}

.p-btn-primary {
  background: var(--color-primary);
  color: #ffffff;
}

.home {
  text-align: center;
  padding: 40rpx 0;
}

/* 产品详情弹层 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  position: relative;
  width: 100%;
  height: 85vh;
  background: var(--color-bg);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pd-close {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: var(--color-text);
  font-size: 32rpx;
}

.pd-swiper {
  width: 100%;
  height: 520rpx;
  background: var(--color-placeholder);
  flex-shrink: 0;
}

.pd-image {
  width: 100%;
  height: 100%;
}

.pd-scroll {
  flex: 1;
  min-height: 0;
}

.pd-body {
  padding: 28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.pd-cat {
  display: inline-block;
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-bottom: 16rpx;
}

.pd-name {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.pd-price {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.pd-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.pd-reason {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.pd-section {
  margin-top: 32rpx;
  border-top: 2rpx solid var(--color-border);
  padding-top: 24rpx;
}

.pd-sec-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.pd-ing {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.9;
}

.pd-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* 保留纯文本换行（产品介绍等内容来自 textarea 多行输入） */
.pd-pre {
  white-space: pre-line;
  word-break: break-all;
}

.pd-search {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  margin-top: 32rpx;
  padding: 0;
  font-size: 28rpx;
  color: var(--color-primary-strong);
}

.pd-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 40rpx;
}

.pd-actions .p-btn {
  height: 80rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
}

.cond-row:last-child,
.zone:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.result-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.report-actions-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  box-shadow: 0 -4rpx 20rpx rgba(43, 43, 43, 0.05);
}

.report-action {
  flex: 1;
  font-size: 28rpx;
}

.ai-disclaimer {
  padding: 24rpx 8rpx 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-muted-strong);
}

.pd-cat {
  color: var(--color-primary-strong);
}
