.state {
  text-align: center;
  padding: 120rpx 0;
}

.retry {
  margin: 40rpx auto 0;
  width: 300rpx;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.score-num {
  font-size: 96rpx;
  font-weight: 700;
}

.score-unit {
  font-size: 28rpx;
  color: #8a8577;
  margin-left: 8rpx;
}

.meta {
  font-size: 26rpx;
  color: #5a5546;
  line-height: 1.8;
}

.summary {
  margin-top: 24rpx;
  color: #5a5546;
  font-size: 28rpx;
}

.dim-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dim-label {
  width: 180rpx;
  font-size: 26rpx;
}

.dim-bar {
  flex: 1;
  height: 10rpx;
  background: #eee7da;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.dim-bar-inner {
  height: 100%;
  background: #6b7a4f;
  border-radius: 999rpx;
}

.dim-score {
  width: 140rpx;
  font-size: 26rpx;
  text-align: right;
}

.dim-grade {
  color: #8a8577;
  font-size: 22rpx;
}

.issue-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.issue-title {
  font-size: 30rpx;
  font-weight: 600;
}

.issue-sev {
  font-size: 22rpx;
  color: #b3543f;
  border: 2rpx solid #b3543f;
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}

.issue-block {
  font-size: 26rpx;
  color: #5a5546;
  margin-top: 10rpx;
}

.cond-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0ebe0;
}

.cond-name {
  font-size: 28rpx;
}

.cond-sev {
  font-size: 22rpx;
  color: #b3543f;
}

.zone {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0ebe0;
}

.zone-label {
  width: 120rpx;
  font-weight: 600;
  font-size: 26rpx;
}

.zone-body {
  flex: 1;
  font-size: 26rpx;
  color: #5a5546;
}

.strength {
  padding: 8rpx 0;
  color: #5a5546;
}

.p-main {
  display: flex;
  gap: 24rpx;
}

.p-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f0ebe0;
  flex-shrink: 0;
}

.p-body {
  flex: 1;
  min-width: 0;
}

.p-name {
  font-weight: 600;
}

.p-reason {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.p-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.p-price {
  color: #b3543f;
  font-weight: 600;
}

.p-detail-hint {
  font-size: 24rpx;
  color: #6b7a4f;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action {
  flex: 1;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.radar-card {
  display: flex;
  justify-content: center;
}

.radar-canvas {
  width: 320px;
  height: 320px;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 360px;
  height: 480px;
}

.p-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.p-btn {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #f0ebe0;
  color: #3D4430;
  margin: 0;
  line-height: 1.6;
}

.p-btn-primary {
  background: #3D4430;
  color: #F2EDE5;
}

.home {
  text-align: center;
  padding: 40rpx 0;
}

/* 产品详情弹层 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  position: relative;
  width: 100%;
  height: 85vh;
  background: #F2EDE5;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pd-close {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  z-index: 10;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #3D4430;
  font-size: 30rpx;
}

.pd-swiper {
  width: 100%;
  height: 520rpx;
  background: #f5f0e8;
  flex-shrink: 0;
}

.pd-image {
  width: 100%;
  height: 100%;
}

.pd-scroll {
  flex: 1;
  min-height: 0;
}

.pd-body {
  padding: 28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.pd-cat {
  display: inline-block;
  font-size: 22rpx;
  color: #5c4937;
  background: rgba(61, 68, 48, 0.08);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-bottom: 16rpx;
}

.pd-name {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.pd-price {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #b3543f;
}

.pd-reason {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #5a5546;
  line-height: 1.7;
}

.pd-section {
  margin-top: 32rpx;
  border-top: 2rpx solid rgba(61, 68, 48, 0.08);
  padding-top: 24rpx;
}

.pd-sec-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.pd-ing {
  font-size: 28rpx;
  color: #5a5546;
  line-height: 1.9;
}

.pd-text {
  font-size: 28rpx;
  color: #5a5546;
  line-height: 1.7;
}

.pd-search {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #3D4430;
}

.pd-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

.pd-actions .p-btn {
  font-size: 28rpx;
  padding: 16rpx 40rpx;
}
