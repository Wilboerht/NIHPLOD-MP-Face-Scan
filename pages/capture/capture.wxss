.capture-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--color-bg);
}

.camera-wrap {
  position: relative;
  width: 100%;
  flex: 1;
  min-height: 360rpx;
  background: var(--color-text);
}

.camera {
  width: 100%;
  height: 100%;
}

.camera-flash {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #ffffff;
  opacity: 0;
  pointer-events: none;
}

.flash-on {
  animation: camera-flash 0.35s ease-out;
}

@keyframes camera-flash {
  0% { opacity: 0.85; }
  100% { opacity: 0; }
}

.face-guide {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 420rpx;
  height: 560rpx;
  border: 4rpx dashed rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  pointer-events: none;
}

.step-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 20rpx;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  pointer-events: none;
}

.step-item {
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  background: rgba(0, 0, 0, 0.35);
}

.step-active {
  color: #ffffff;
  background: var(--color-primary);
}

.step-done {
  color: #ffffff;
  background: var(--color-success-strong);
}

.instruction {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  padding: 28rpx 32rpx 4rpx;
}

.status-hint {
  text-align: center;
  font-size: 26rpx;
  color: var(--color-primary-strong);
  padding: 8rpx 32rpx;
  min-height: 40rpx;
}

.mode-tip {
  text-align: center;
  padding: 4rpx 32rpx;
}

.skin-state {
  padding: 16rpx 32rpx;
}

.ss-label {
  margin-bottom: 12rpx;
}

.ss-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ss-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.ss-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
}

.shutter-area {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}

.shutter {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 8rpx solid var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.shutter-inner {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.shutter-disabled {
  opacity: 0.4;
}

.auto-tip {
  text-align: center;
}
