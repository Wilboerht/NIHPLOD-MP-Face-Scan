<view class="container safe-bottom">
  <view wx:if="{{notLoggedIn}}" class="state">
    <view class="text-muted">登录后可查看历史测肤报告</view>
    <button class="btn-primary retry" bindtap="onGoLogin">去登录</button>
  </view>

  <block wx:elif="{{loading}}">
    <view class="card skeleton-card" wx:for="{{skeletonRows}}" wx:key="*this">
      <view class="skeleton-block skeleton-score"></view>
      <view class="skeleton-info">
        <view class="skeleton-block skeleton-line"></view>
        <view class="skeleton-block skeleton-line short"></view>
      </view>
    </view>
  </block>

  <view wx:elif="{{loadError}}" class="state">
    <view class="text-muted">{{loadError}}</view>
    <button class="btn-plain retry" bindtap="onRetry">重试</button>
  </view>

  <view wx:elif="{{list.length === 0}}" class="state">
    <view class="empty-title">还没有测肤记录</view>
    <view class="text-muted empty-desc">完成一次测肤，就能在这里回看肌肤变化</view>
    <button class="btn-primary retry" bindtap="onGoQuestionnaire">去测肤</button>
  </view>

  <block wx:else>
    <view
      class="card item"
      wx:for="{{list}}"
      wx:key="sessionId"
      data-session-id="{{item.sessionId}}"
      bindtap="onItemTap"
      hover-class="row-hover"
      aria-role="button"
      aria-label="{{item.timeText}} 测肤报告"
    >
      <view class="item-main">
        <view class="item-score" wx:if="{{item.score !== null}}">{{item.score}}<text class="item-unit">分</text></view>
        <view class="item-score item-empty" wx:else>—</view>
        <view class="item-info">
          <view wx:if="{{item.typeLabel}}">{{item.typeLabel}}</view>
          <view class="text-muted">{{item.timeText}}</view>
        </view>
      </view>
      <view class="arrow" aria-hidden="true">›</view>
    </view>

    <view wx:if="{{loadingMore}}" class="load-more text-muted">加载中…</view>
    <view wx:elif="{{page < totalPages}}" class="load-more text-muted" bindtap="onLoadMore" hover-class="row-hover" aria-role="button">上滑加载更多</view>
    <view wx:else class="load-more text-muted">没有更多了</view>
  </block>
</view>
