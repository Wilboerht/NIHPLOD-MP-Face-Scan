.state {
  text-align: center;
  padding: 120rpx 0;
}

.retry {
  margin: 40rpx auto 0;
  width: 300rpx;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
}

.item-main {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.item-score {
  font-size: 48rpx;
  font-weight: 700;
  width: 120rpx;
  color: var(--color-logo-navy);
}

.item-empty {
  color: var(--color-muted);
}

.item-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-muted-strong);
  margin-left: 4rpx;
}

.item-info {
  font-size: 28rpx;
}

.arrow {
  color: #b8a992;
  font-size: 36rpx;
}

.load-more {
  text-align: center;
  padding: 32rpx 0 0;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  margin-bottom: 32rpx;
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-height: 100rpx;
}

.skeleton-block {
  background: var(--color-placeholder);
  border-radius: 8rpx;
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}

.skeleton-score {
  width: 120rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.skeleton-info {
  flex: 1;
}

.skeleton-line {
  width: 62%;
  height: 28rpx;
  margin-bottom: 12rpx;
}

.skeleton-line.short {
  width: 42%;
  height: 22rpx;
  margin-bottom: 0;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}
