.state {
  text-align: center;
  padding: 120rpx 0;
}

.retry {
  margin: 40rpx auto 0;
  width: 300rpx;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: 12rpx;
}

.progress-back {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx 0 0;
  font-size: 26rpx;
  color: var(--color-primary-strong);
}

.progress-text {
  font-size: 24rpx;
}

.progress-bar {
  height: 8rpx;
  margin-bottom: 28rpx;
  background: var(--color-border);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: var(--color-primary);
  border-radius: 999rpx;
  transition: width 0.2s ease;
}

.q-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.q-subtext {
  margin-bottom: 24rpx;
}

.options {
  margin-top: 24rpx;
}

.option {
  min-height: 96rpx;
  background: var(--color-card);
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.option-hover {
  background: var(--color-warm-soft);
}

.option-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.option-check {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-strong);
}

.option-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.option-active .option-label {
  color: var(--color-primary-strong);
  font-weight: 600;
}

.option-label {
  font-size: 30rpx;
}

.option-desc {
  margin-top: 6rpx;
}

.next-btn {
  margin-top: 32rpx;
}

.prev {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-primary-strong);
}

/* 测肤次数预检拦截卡 */
.limit-block {
  padding-top: 100rpx;
}

.limit-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.limit-message {
  margin-bottom: 48rpx;
}

.limit-btn {
  width: 320rpx;
  margin: 0 auto 24rpx;
}
