.state {
  text-align: center;
  padding: 120rpx 0;
}

.retry {
  margin: 40rpx auto 0;
  width: 300rpx;
}

.progress {
  text-align: right;
  margin-bottom: 16rpx;
}

.q-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.q-subtext {
  margin-bottom: 24rpx;
}

.options {
  margin-top: 24rpx;
}

.option {
  background: #FFFFFF;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.option-active {
  border-color: #3D4430;
  background: #f7f3ea;
}

.option-label {
  font-size: 30rpx;
}

.option-desc {
  margin-top: 6rpx;
}

.next-btn {
  margin-top: 32rpx;
}

.prev {
  text-align: center;
  margin-top: 32rpx;
  padding: 16rpx;
}

/* 测肤次数预检拦截卡 */
.limit-block {
  padding-top: 100rpx;
}

.limit-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.limit-message {
  margin-bottom: 48rpx;
}

.limit-btn {
  width: 320rpx;
  margin: 0 auto 24rpx;
}
