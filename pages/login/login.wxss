.login-page {
  padding-top: 56rpx;
}

.logo-area {
  text-align: center;
  margin-bottom: 40rpx;
}

.login-logo {
  width: 320rpx;
  height: 90rpx;
  margin: 0 auto;
}

.value-card {
  padding: 8rpx 28rpx;
  margin-bottom: 32rpx;
}

.value-row {
  position: relative;
  padding: 14rpx 0 14rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.value-row::before {
  content: "";
  position: absolute;
  left: 0;
  top: 27rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.tip {
  font-size: 26rpx;
  color: var(--color-muted-strong);
  margin-top: 20rpx;
}

.protocol {
  text-align: center;
  margin-top: 40rpx;
}

.protocol-link {
  color: var(--color-primary-strong);
}

.bind-tip {
  text-align: center;
  margin-bottom: 48rpx;
}

.bind-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.bind-desc {
  font-size: 26rpx;
  color: var(--color-muted-strong);
  line-height: 1.6;
}

.skip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
}
