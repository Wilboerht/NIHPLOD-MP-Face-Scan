/* 测肤档案 */
.archive-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.state {
  text-align: center;
  padding: 120rpx 0;
}

.state-btn {
  margin: 40rpx auto 0;
  width: 300rpx;
}

/* 统计卡 */
.stats {
  display: flex;
  align-items: center;
  padding: 36rpx 16rpx;
}

.stat {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-logo-navy);
}

.stat-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-muted-strong);
  margin-left: 4rpx;
}

.stat-label {
  margin-top: 8rpx;
}

/* 趋势区 */
.range-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.range-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-primary-soft);
}

.range-active {
  background: var(--color-primary);
  color: #ffffff;
}

.trend-hint {
  text-align: center;
  padding: 48rpx 24rpx;
  line-height: 1.8;
}

.retry-btn {
  margin: 0 auto;
  width: 240rpx;
}

.trend-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.trend-latest {
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.trend-score {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-logo-navy);
}

.trend-delta {
  font-size: 24rpx;
  color: var(--color-muted-strong);
}

.delta-up {
  color: var(--color-success-strong);
}

.delta-down {
  color: var(--color-danger-strong);
}

.trend-canvas {
  width: 100%;
  height: 360rpx;
}

.more-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  min-height: 72rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

.more-arrow {
  font-size: 30rpx;
}

/* 打卡色带 */
.band {
  display: flex;
  gap: 6rpx;
  align-items: center;
}

.band-item {
  flex: 1;
  height: 40rpx;
  border-radius: 8rpx;
}

.band-today {
  border: 2rpx solid var(--color-primary);
}

.band-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.band-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  margin-top: 18rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted-strong);
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.checkin-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
}

/* 时间线 */
.day {
  margin-bottom: 24rpx;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.day-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.day-today {
  color: var(--color-text);
}

.day-add {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-primary-strong);
}

.event {
  margin-bottom: 16rpx;
}

.ev-diary {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}

.ev-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.ev-body {
  flex: 1;
  min-width: 0;
}

.ev-title {
  font-size: 28rpx;
}

.ev-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.ev-tag {
  font-size: 22rpx;
  color: var(--color-primary-strong);
  background: var(--color-primary-soft);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.ev-note {
  margin-top: 10rpx;
  line-height: 1.6;
  word-break: break-all;
}

.ev-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
}

.ev-test {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
}

.ev-test-score {
  font-size: 44rpx;
  font-weight: 700;
  min-width: 110rpx;
}

.ev-test-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-muted-strong);
  margin-left: 4rpx;
}

.ev-test-empty {
  color: var(--color-muted);
}

.ev-test-info {
  flex: 1;
  min-width: 0;
  line-height: 1.6;
}

.load-more {
  text-align: center;
  padding: 24rpx 0 0;
}

/* 区块错误条（测肤记录加载失败） */
.sec-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.sec-retry {
  flex-shrink: 0;
  padding: 8rpx 32rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 24rpx;
}

.link {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

.link-danger {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-danger-strong);
}

.link-plain {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--color-muted-strong);
}

/* 打卡弹层 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  height: 78vh;
  background: var(--color-bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-head {
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  margin-bottom: 16rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.sheet-close {
  position: absolute;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-card);
  color: var(--color-text);
  font-size: 30rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-label {
  font-size: 26rpx;
  color: var(--color-muted-strong);
  margin: 24rpx 0 14rpx;
}

.sheet-row .sheet-label {
  margin: 0;
}

.sheet-date {
  font-size: 30rpx;
  color: var(--color-text);
  padding: 8rpx 24rpx;
  background: #ffffff;
  border-radius: 999rpx;
}

.state-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.state-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
  background: var(--color-card);
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.state-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
  font-weight: 600;
}

.state-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.tag-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
  font-weight: 600;
}

.sheet-note {
  width: 100%;
  min-height: 120rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.sheet-save {
  margin-top: 40rpx;
}

.sheet-delete {
  text-align: center;
  padding: 28rpx 0 0;
  font-size: 26rpx;
  color: var(--color-danger-strong);
}

.sheet-cancel {
  text-align: center;
  padding: 24rpx 0 0;
}
