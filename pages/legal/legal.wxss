.legal-page {
  padding-bottom: 60rpx;
}

.legal-meta {
  margin: 8rpx 0 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a8577;
}

.legal-section {
  margin-bottom: 36rpx;
}

.legal-section:last-of-type {
  margin-bottom: 0;
}

.legal-heading {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
  color: #3D4430;
}

.legal-para {
  font-size: 26rpx;
  line-height: 1.8;
  color: #3D4430;
  margin-bottom: 12rpx;
}

.legal-para:last-child {
  margin-bottom: 0;
}

.legal-foot {
  margin-top: 48rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: #8a8577;
}
