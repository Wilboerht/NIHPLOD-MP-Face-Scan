.legal-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.legal-meta {
  margin: 8rpx 0 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted-strong);
}

.legal-section {
  margin-bottom: 36rpx;
}

.legal-section:last-of-type {
  margin-bottom: 0;
}

.legal-heading {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
  color: var(--color-text);
}

.legal-para {
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.legal-para:last-child {
  margin-bottom: 0;
}

.legal-foot {
  margin-top: 48rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--color-muted-strong);
}
